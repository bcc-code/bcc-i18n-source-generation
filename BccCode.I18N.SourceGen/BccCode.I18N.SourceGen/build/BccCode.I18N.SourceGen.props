<Project>
  <PropertyGroup>
    <!-- Default fallback language if not specified by the consuming project -->
    <FallbackLanguage Condition="'$(FallbackLanguage)' == ''">no</FallbackLanguage>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="FallbackLanguage" />
    <CompilerVisibleProperty Include="GeneratedNamespace" />
    <!-- The generator falls back to RootNamespace when GeneratedNamespace is empty. It is read at compile
         time rather than defaulted here, because this file is imported before the project sets RootNamespace. -->
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="I18NLanguageAliases" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="I18NTranslation" />
  </ItemGroup>
</Project>

